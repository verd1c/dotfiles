# zsh — oh-my-zsh, kept deliberately small so startup stays under ~100ms.
# Check it with: for i in $(seq 5); do time zsh -i -c exit; done

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

# Every plugin here is code sourced at startup, so this list is a latency
# budget, not a wishlist. These three pay for themselves:
#   git                    - branch in the prompt, plus gst/gco/glog aliases
#   zsh-autosuggestions    - greys in the rest of the line from history
#   zsh-syntax-highlighting- red command name = typo, before you hit enter
# syntax-highlighting must stay LAST; it wraps the line editor and anything
# loaded after it silently loses highlighting.
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

source "$ZSH/oh-my-zsh.sh"

# ---------- history ----------
# Big, shared across every kitty split, deduped. INC_APPEND_SHARE means a
# command is visible in your other panes immediately, not at shell exit.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY INC_APPEND_HISTORY EXTENDED_HISTORY
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS
setopt HIST_VERIFY          # expand !! and let you see it before running

# ---------- navigation ----------
setopt AUTO_CD              # `src` instead of `cd src`
setopt AUTO_PUSHD PUSHD_IGNORE_DUPS
setopt EXTENDED_GLOB        # ^ ~ # in globs; needed for **/*~*test*

# ---------- completion ----------
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' menu select                        # arrow-key menu
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ---------- keys ----------
# Up/Down search history by what's already typed, rather than walking it all.
autoload -U up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[[1;5C' forward-word      # ctrl+right
bindkey '^[[1;5D' backward-word     # ctrl+left

# kitty maps ctrl+v to paste, so quoted-insert lives here instead. Press it
# then any key to print that key's raw escape sequence - that is how the two
# bindkey lines above were derived.
bindkey '^[v' quoted-insert

# ---------- modern cli tools ----------
# Every block is guarded: this file is symlinked onto machines that may not
# have these installed yet, and an unguarded eval would break the shell.

# Ubuntu renames both of these to dodge clashes with older packages.
command -v fdfind >/dev/null && alias fd='fdfind'
command -v batcat >/dev/null && alias bat='batcat'

if command -v eza >/dev/null; then
    alias ls='eza --group-directories-first'
    alias ll='eza -l --git --group-directories-first'
    alias la='eza -la --git --group-directories-first'
    alias lt='eza --tree --level=2'
fi

# fzf: ctrl+r fuzzy-searches history (the big one, given HISTSIZE=100000),
# ctrl+t inserts a file path, alt+c cds into a directory.
if command -v fzf >/dev/null; then
    source <(fzf --zsh)
    export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --info=inline'
    # Search hidden files but never walk into .git - it is all noise.
    command -v fdfind >/dev/null && \
        export FZF_DEFAULT_COMMAND='fdfind --type f --hidden --exclude .git'
fi

# zoxide: `z nyx` from anywhere. Ranks by how often and how recently you
# actually visit a directory. Must come after oh-my-zsh, which runs compinit.
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# ---------- env ----------
export PATH="$HOME/.local/bin:$PATH"
export EDITOR="${EDITOR:-vi}"

# Machine-specific bits that should NOT be committed (tokens, per-box paths).
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
